    "node": "24.x"
  },
  "packageManager": "bun@1.3.14",
  "patchedDependencies": {
    "node-forge@github:digitalbazaar/forge#ceba344": "patches/node-forge-null-parameters.patch"
  },
  "trustedDependencies": []
}
