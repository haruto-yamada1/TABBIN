{
  "name": "tabbin",
  "version": "2.0.17",
  "private": true,
  "description": "An extension for organizing and categorizing browser tabs so cluttered tab lists stay manageable.",
  "workspaces": [
    "tools/legacy-tooling"
  ],
  "type": "module",
  "imports": {
    "#default-language": "./src/constants/language.ts",
    "#extension-permissions": "./src/constants/extensionPermissions.ts",
    "#harness-state": "./tools/harness/state/index.ts",
    "#production-network-policy": "./src/constants/productionNetworkPolicy.ts",
    "#typescript-parser": "./tools/typescript/native-parser.mjs"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "size:report": "bun tools/scripts/report-artifact-size.ts",
    "release:check": "git diff --exit-code && bun run quality:check && bun run build && bun run build:firefox && bun run verify:production-logging && bun run verify:app-version && bun run verify:persistence-release-compatibility && bun run verify:production-network-policy && bun run verify:firefox-artifact && bun run verify:firefox-source && git diff --exit-code",
    "release:zip": "bun run release:check && bun run zip && bun run zip:firefox && bun run release:provenance",
    "compile": "node node_modules/typescript/bin/tsc --noEmit",
    "secretlint": "secretlint \"**/*\"",
    "security:audit": "bun run verify:node-forge-backport && bun audit --audit-level=high",
    "postinstall": "wxt prepare",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "validate:html": "html-validate --config .htmlvalidate.json --ext tsx,html src",
    "verify:tooling-dependencies": "node tools/scripts/verify-tooling-dependencies.mjs",
    "verify:node-forge-backport": "bun tools/scripts/verify-node-forge-backport.ts",
    "verify:production-logging": "node tools/scripts/verify-production-logging.ts",
    "verify:production-network-policy": "node tools/scripts/verify-production-network-policy.ts",
    "verify:persistence-release-compatibility": "bun tools/scripts/verify-persistence-release-compatibility.ts",
    "verify:storage-writer-inventory": "node tools/scripts/verify-storage-writer-inventory.ts",
    "verify:firefox-artifact": "bun tools/scripts/verify-firefox-artifact.ts",
    "verify:firefox-source": "bun tools/scripts/verify-firefox-source-contract.ts",
    "check": "bun run format:check && bun run compile && bun run lint",
    "agent:check": "bash .apm/skills/check/scripts/run_quality.sh",
    "check:write": "bun run lint:fix && bun run format",
    "check:duplication": "jscpd --config .jscpd.json",
    "arch:check": "node tools/legacy-tooling/arch-check.mjs --config .dependency-cruiser.cjs src --output-type err",
    "quality:check": "bun run format:check && bun run verify:tooling-dependencies && bun run verify:toolchain-versions && bun run verify:storage-writer-inventory && bun run verify:firefox-source && bun run compile && bun run lint && bun run validate:html && bun run test && bun run knip && bun run check:duplication && bun run secretlint && bun run arch:check",
    "quality:fix": "bun run check:write",
    "test": "vitest run --config vitest.ci.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.ci.config.ts --max-workers=2",
    "test:indexeddb:browsers": "playwright test --config playwright.indexeddb.config.ts",
    "benchmark:persistence": "bun src/contexts/saved-tabs/infrastructure/persistence/indexed-db/benchmarkIndexedDbPersistence.ts",
    "test:node": "vitest run --config vitest.ci.config.ts --project=node",
    "test:dom": "vitest run --config vitest.ci.config.ts --project=dom",
    "test:changed": "vitest run --config vitest.ci.config.ts --changed",
    "test:related": "vitest related --run --config vitest.ci.config.ts",
    "harness:start": "bun tools/scripts/harness.ts start",
    "harness:plan": "bun tools/scripts/harness.ts plan",
    "harness:evaluate": "bun tools/scripts/harness.ts evaluate",
    "harness:checkpoint": "bun tools/scripts/harness.ts checkpoint",
    "harness:validate": "bun tools/scripts/harness.ts validate",
    "harness:status": "bun tools/scripts/harness.ts status",
    "harness:audit": "bun tools/scripts/harness.ts audit",
    "harness:surface-audit": "bun tools/scripts/harness.ts surface-audit",
    "harness:security-audit": "bun tools/scripts/harness.ts security-audit",
    "harness:repo-status": "bun tools/scripts/harness.ts repo-status",
    "harness:learn": "bun tools/scripts/harness.ts learn",
    "harness:profile": "bun tools/scripts/harness.ts profile",
    "harness:governance": "bun tools/scripts/harness.ts governance",
    "harness:schemas": "bun tools/scripts/harness.ts schemas",
    "waza:check": "bun tools/scripts/run-waza-eval.ts check",
    "waza:spec:verify": "bun tools/scripts/run-waza-eval.ts spec-verify",
    "waza:eval:check": "bun tools/scripts/run-waza-eval.ts run",
    "waza:adversarial": "bun tools/scripts/run-waza-eval.ts adversarial",
    "storybook": "BROWSER=none storybook dev -p 6006",
    "build-storybook": "storybook build",
    "e2e": "playwright test e2e",
    "e2e:a11y": "playwright test e2e --project=extension --grep 'accessibility'",
    "test:firefox:smoke": "playwright test --config playwright.firefox.config.ts",
    "build:firefox:indexeddb-smoke-harness": "bun build e2e/support/firefox-persistence-indexeddb-harness.ts --outfile=.output/firefox-persistence-indexeddb-harness.js --target=browser --format=iife --define 'import.meta.env={\"DEV\":false,\"PROD\":true,\"MODE\":\"test\"}'",
    "test:firefox:indexeddb-smoke": "bun run build:firefox && bun run build:firefox:indexeddb-smoke-harness && bun tools/scripts/firefox-persistence-indexeddb-smoke.ts",
    "test:production-artifact-upgrade": "bun tools/scripts/production-artifact-upgrade-smoke.ts",
    "knip": "knip",
    "doctor": "react-doctor",
    "verify:app-version": "bun tools/scripts/verify-app-version.ts",
    "verify:toolchain-versions": "bun tools/scripts/verify-toolchain-versions.ts",
    "sync:toolchain-versions": "bun tools/scripts/sync-toolchain-versions.ts",
    "apm:check": "bun tools/scripts/sync-agent-config-cli.ts --check",
    "apm:sync": "bun tools/scripts/sync-agent-config-cli.ts",
    "release:provenance": "bun tools/scripts/generate-release-provenance.ts",
    "waza:trace-eval": "bun tools/scripts/evaluate-waza-trace.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@rive-app/react-webgl2": "^4.36.0",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@xyflow/react": "^12.12.0",
    "ai": "^7.0.127",
    "ai-sdk-ollama": "^4.4.0",
    "anser": "^2.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "escape-carriage": "^1.3.1",
    "fuse.js": "^7.5.0",
    "immer": "^11.1.21",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "nanoid": "^6.0.1",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.2",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "recharts": "3.10.1",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.6",
    "webextension-polyfill": "^0.12.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@chromatic-com/storybook": "^5.4.0",
    "@cyclonedx/cyclonedx-library": "^10.3.0",
    "@playwright/test": "^1.63.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@storybook/addon-onboarding": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@swc/core": "^1.16.13",
    "@tabbin/legacy-tooling": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chrome": "^0.3.4",
    "@types/node": "^24.19.1",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "@wxt-dev/i18n": "^0.2.8",
    "@wxt-dev/module-react": "^1.2.2",
    "autoprefixer": "^10.6.1",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.14.5",
    "html-validate": "^11.16.2",
    "jscpd": "^5.4.0",
    "jsdom": "^30.1.2",
    "json5": "^2.2.3",
    "knip": "^6.39.0",
    "node-forge": "github:digitalbazaar/forge#ceba34402e329f0365134f23fe19898756527d65",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "react-doctor": "^0.9.16",
    "react-jsx-parser": "^2.4.1",
    "secretlint": "^13.0.7",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "browserslist": "4.28.8",
    "defu": "6.1.7",
    "fast-uri": "3.1.8",
    "js-yaml": "4.3.2",
    "lodash-es": "4.18.1",
    "node-forge": "github:digitalbazaar/forge#ceba34402e329f0365134f23fe19898756527d65",
    "postcss": "8.5.28",
    "rollup": "4.62.2",
    "shell-quote": "1.11.0",
    "smol-toml": "1.7.1",
    "source-map-js": "1.2.2",
    "tmp": "0.2.7"
  },
  "engines": {
