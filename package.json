{
  "name": "tabbin",
  "version": "2.0.7",
  "private": true,
  "description": "An extension for organizing and categorizing browser tabs so cluttered tab lists stay manageable.",
  "type": "module",
  "imports": {
    "#harness-state": "./tools/harness/state/index.ts"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "release:check": "git diff --exit-code && bun run quality:check && bun run build && bun run build:firefox && bun run verify:app-version && git diff --exit-code",
    "release:zip": "bun run release:check && bun run zip && bun run zip:firefox",
    "compile": "tsgo --noEmit",
    "secretlint": "secretlint \"**/*\"",
    "security:audit": "bun audit --audit-level=high --ignore GHSA-22p9-wv53-3rq4 --ignore GHSA-3ppc-4f35-3m26 --ignore GHSA-7r86-cg39-jmmj --ignore GHSA-23c5-xmqv-rm74 --ignore GHSA-c2c7-rcm5-vvqj --ignore GHSA-fx2h-pf6j-xcff --ignore GHSA-p9ff-h696-f583",
    "postinstall": "wxt prepare",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "validate:html": "html-validate --config .htmlvalidate.json --ext tsx,html src",
    "verify:tooling-dependencies": "node tools/scripts/verify-tooling-dependencies.mjs",
    "check": "bun run format:check && bun run compile && bun run lint",
    "check:write": "bun run lint:fix && bun run format",
    "check:duplication": "jscpd --config .jscpd.json",
    "arch:check": "depcruise --config .dependency-cruiser.cjs src --output-type err",
    "quality:check": "bun run format:check && bun run verify:tooling-dependencies && bun run compile && bun run lint && bun run validate:html && bun run test && bun run knip && bun run check:duplication && bun run secretlint && bun run arch:check",
    "quality:fix": "bun run check:write",
    "test": "vitest run --config vitest.ci.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.ci.config.ts --max-workers=2",
    "test:node": "vitest run --config vitest.ci.config.ts --project=node",
    "test:dom": "vitest run --config vitest.ci.config.ts --project=dom",
    "test:changed": "vitest run --config vitest.ci.config.ts --changed",
    "test:related": "vitest related --run --config vitest.ci.config.ts",
    "harness:start": "bun tools/scripts/harness.ts start",
    "harness:plan": "bun tools/scripts/harness.ts plan",
    "harness:evaluate": "bun tools/scripts/harness.ts evaluate",
    "harness:checkpoint": "bun tools/scripts/harness.ts checkpoint",
    "harness:validate": "bun tools/scripts/harness.ts validate",
    "harness:status": "bun tools/scripts/harness.ts status",
    "harness:audit": "bun tools/scripts/harness.ts audit",
    "harness:surface-audit": "bun tools/scripts/harness.ts surface-audit",
    "harness:security-audit": "bun tools/scripts/harness.ts security-audit",
    "harness:repo-status": "bun tools/scripts/harness.ts repo-status",
    "harness:learn": "bun tools/scripts/harness.ts learn",
    "harness:profile": "bun tools/scripts/harness.ts profile",
    "harness:governance": "bun tools/scripts/harness.ts governance",
    "harness:schemas": "bun tools/scripts/harness.ts schemas",
    "storybook": "BROWSER=none storybook dev -p 6006",
    "build-storybook": "storybook build",
    "e2e": "playwright test e2e",
    "knip": "knip",
    "doctor": "react-doctor",
    "verify:app-version": "bun tools/scripts/verify-app-version.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-accordion": "^1.2.15",
    "@radix-ui/react-alert-dialog": "^1.1.18",
    "@radix-ui/react-avatar": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.3.6",
    "@radix-ui/react-collapsible": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-hover-card": "^1.1.18",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.18",
    "@radix-ui/react-progress": "^1.1.11",
    "@radix-ui/react-scroll-area": "^1.2.13",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.2",
    "@radix-ui/react-tabs": "^1.1.16",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@radix-ui/react-use-controllable-state": "^1.2.3",
    "@rive-app/react-webgl2": "^4.29.4",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-virtual": "^3.14.5",
    "@xyflow/react": "^12.11.1",
    "ai": "^7.0.15",
    "ai-sdk-ollama": "^4.0.0",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "fuse.js": "^7.4.2",
    "immer": "^11.1.11",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "nanoid": "^5.1.16",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.80.0",
    "react-jsx-parser": "^2.4.1",
    "react-router-dom": "^7.18.1",
    "recharts": "3.9.2",
    "shiki": "^4.3.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.6",
    "uuid": "^14.0.1",
    "webextension-polyfill": "^0.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint-react/eslint-plugin": "^5.10.3",
    "@playwright/test": "^1.61.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
    "@storybook/addon-onboarding": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/react": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.2.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/webextension-polyfill": "^0.12.5",
    "@typescript/native-preview": "^7.0.0-dev.20260703.1",
    "@vitest/browser": "^4.1.9",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "@wxt-dev/i18n": "^0.2.6",
    "@wxt-dev/module-react": "^1.2.2",
    "autoprefixer": "^10.5.2",
    "dependency-cruiser": "^18.0.0",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.4.6",
    "eslint-plugin-testing-library": "^7.16.2",
    "happy-dom": "^20.10.6",
    "html-validate": "^11.5.5",
    "jscpd": "^5.0.11",
    "jsdom": "^29.1.1",
    "knip": "^6.24.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "oxlint-tsgolint": "^0.24.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.16",
    "react-doctor": "^0.7.0",
    "secretlint": "^13.0.2",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.3.2",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "wxt": "^0.20.27"
  },
  "overrides": {
    "defu": "6.1.7",
    "lodash-es": "4.18.1",
    "node-forge": "1.4.0",
    "rollup": "4.62.2",
    "shell-quote": "1.10.0",
    "tmp": "0.2.7",
    "undici": "7.28.0"
  },
  "engines": {
    "bun": "1.3.14",
    "node": "24.x"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": []
}
