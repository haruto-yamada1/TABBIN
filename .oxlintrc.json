    {
      "files": ["src/contexts/*/domain/**/*.{ts,tsx}"],
      "rules": {
        "eslint/no-restricted-globals": [
          "error",
          {
            "name": "chrome",
            "message": "domain 層は chrome.* を直接利用できません（adapter / port 経由）"
