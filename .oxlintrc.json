          {
            "name": "localStorage",
            "message": "domain 層は localStorage を直接利用できません"
          },
          {
            "name": "sessionStorage",
            "message": "domain 層は sessionStorage を直接利用できません"
          },
          {
            "name": "document",
            "message": "domain 層は document に依存できません"
          },
          {
            "name": "window",
            "message": "domain 層は window に依存できません"
          }
        ],
