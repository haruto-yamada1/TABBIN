        "vitest.ci.config.ts",
        "wxt.config.ts",
        "tailwind.config.js",
        "vitest.workspace.ts",
        "src/entrypoints/**"
      ],
      "env": { "node": true, "es2024": true },
      "rules": {
        "import/no-default-export": "off",
