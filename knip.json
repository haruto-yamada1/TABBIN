{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "src/entrypoints/**/*.{ts,tsx}",
    "src/app/**/*.{test,stories}.{ts,tsx}",
    "src/components/**/*.{test,stories}.{ts,tsx}",
    "src/contexts/**/*.{test,stories}.{ts,tsx}",
    "src/features/**/*.{test,stories}.{ts,tsx}",
    "src/lib/**/*.{test,stories}.{ts,tsx}",
    "src/utils/**/*.{test,stories}.{ts,tsx}",
    "e2e/**/*.{ts,tsx}",
    "tools/**/*.{ts,tsx}",
    ".storybook/**/*.{ts,tsx}",
    "vitest.config.ts",
    "vitest.workspace.ts"
  ],
  "project": [
    "src/app/**/*.{ts,tsx}",
    "src/components/**/*.{ts,tsx}",
    "src/constants/**/*.ts",
    "src/contexts/**/*.{ts,tsx}",
    "src/entrypoints/**/*.{ts,tsx}",
    "e2e/**/*.{ts,tsx}",
    "src/features/**/*.{ts,tsx}",
    "src/hooks/**/*.{ts,tsx}",
    "src/lib/**/*.{ts,tsx}",
    "src/types/**/*.{ts,tsx,d.ts}",
    "src/utils/**/*.{ts,tsx}",
    "tools/**/*.{ts,tsx}",
    ".storybook/**/*.{ts,tsx}"
  ],
  "include": ["dependencies", "unlisted", "binaries"],
  "ignore": [
    ".output/**",
    ".wxt/**",
    "coverage/**",
    "node_modules/**",
    "playwright-report/**",
    "storybook-static/**",
    "test-results/**",
    "tests-examples/**",
    "start/**"
  ],
  "ignoreFiles": ["src/stories/**", "tests/**"],
  "ignoreDependencies": [
    "@storybook/addon-onboarding",
    "@storybook/builder-vite",
    "@testing-library/jest-dom",
    "autoprefixer",
    "path",
    "postcss",
    "@secretlint/secretlint-rule-preset-recommend"
  ],
  "lefthook": true,
  "playwright": true,
  "storybook": true,
  "vitest": false
}
