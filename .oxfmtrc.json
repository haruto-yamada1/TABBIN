{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "trailingComma": "all",
  "sortImports": {
    "internalPattern": ["@/"],
    "groups": [
      "builtin",
      "external",
      "internal",
      ["parent", "sibling", "index"],
      "style",
      "side_effect",
      "unknown"
    ],
    "newlinesBetween": true
  },
  "ignorePatterns": [
    ".output/**",
    ".wxt/**",
    ".apm/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".cursor/**",
    ".gemini/**",
    ".github/hooks/**",
    ".github/skills/**",
    "wxt.config.ts",
    "node_modules/**",
    "apm_modules/**",
    "coverage/**",
    "test-results/**",
    "playwright-report/**",
    "blob-report/**",
    "storybook-static/**",
    "tmp-profile-saved-tabs.cjs"
  ]
}
