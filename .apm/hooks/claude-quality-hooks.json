{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|apply_patch",
        "hooks": [
          {
            "command": "./scripts/harness-event-capture.sh",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|apply_patch",
        "hooks": [
          {
            "command": "./scripts/track-edit.sh",
            "type": "command"
          },
          {
            "command": "./scripts/format-check-on-edit.sh",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "command": "./scripts/rtk-usage-replace.sh",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|apply_patch",
        "hooks": [
          {
            "command": "./scripts/publish-verify.sh",
            "timeout": 300,
            "type": "command"
          },
          {
            "command": "./scripts/harness-safety-warn.sh",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|apply_patch",
        "hooks": [
          {
            "command": "./scripts/harness-config-protection.sh",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "./scripts/harness-first-edit-gate.sh",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "./scripts/harness-profile-gate.sh",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "./scripts/harness-session-context.sh",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "./scripts/harness-precompact.sh",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "./scripts/stop-verify.sh",
            "timeout": 300,
            "type": "command"
          }
        ]
      }
    ]
  }
}
