{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "updated_at",
    "next_action",
    "categories",
    "verification"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "done",
        "approved",
        "changes_requested",
        "blocked"
      ]
    },
    "summary": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "next_action": {
      "type": "string"
    },
    "overall_score": {
      "type": "number"
    },
    "top_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "status",
          "notes"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "evidence",
          "notes"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "max_score": {
            "type": "number"
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
