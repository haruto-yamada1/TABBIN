{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "updated_at",
    "next_action",
    "candidates",
    "verification"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "done",
        "approved",
        "changes_requested",
        "blocked"
      ]
    },
    "summary": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "next_action": {
      "type": "string"
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "status",
          "notes"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "summary",
          "status"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    }
  }
}
